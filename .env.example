# ========== Facebook API Config ==========
FB_APP_ID=your_app_id
FB_APP_SECRET=your_app_secret
FB_ACCESS_TOKEN=your_access_token
FB_ACCOUNT_ID=act_xxxxx
FB_API_VERSION=v18.0
# 必须与 Meta 开发者后台「有效 OAuth 重定向 URI」完全一致
FB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/meta-auth/callback
FB_OAUTH_SCOPES=ads_management,ads_read,business_management
FRONTEND_BASE_URL=http://localhost:3000

# ========== Database Config ==========
DB_TYPE=postgresql  # postgresql, mongodb
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fb_ads_db
DB_USER=postgres
DB_PASSWORD=your_password
MONGO_URI=mongodb://localhost:27017

# ========== Redis Config ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== Celery Config ==========
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# 定时任务（由 Celery Beat 读取；5 段 cron：分 时 日 月 周）
# 修改后需重启 Beat 进程生效
SCHEDULE_FETCH_INSIGHTS_CRON=0 */2 * * *   # 每 2 小时拉取洞察数据
SCHEDULE_RISK_CHECK_CRON=0 * * * *         # 每小时风控检查
SCHEDULE_REPORT_DAILY_CRON=0 8 * * *       # 每天 8 点生成日报告
SCHEDULE_REPORT_WEEKLY_CRON=0 9 * * 1      # 每周一 9 点生成周报告

# ========== Risk Control Config ==========
RISK_ENABLE=true
RISK_DAILY_SPEND_LIMIT=10000  # 日花费上限
RISK_DAILY_CTR_THRESHOLD=0.02  # CTR下限
RISK_DAILY_CPC_THRESHOLD=5.0   # CPC上限
RISK_FRAUD_SCORE_THRESHOLD=0.7 # 欺诈评分阈值
RISK_ACCOUNT_FREEZE_DAYS=3     # 冻结账户天数

# ========== Logging Config ==========
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
SENTRY_DSN=

# ========== API Server Config ==========
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# SECRET_KEY：JWT 签名密钥，同时用于派生 Access Token 的加密密钥（Fernet）
# 警告：上线后不可随意更改，否则已加密的凭据将无法解密
SECRET_KEY=META_SECRET_#$123

# CORS：前端独立部署时必须放行（逗号分隔），否则 /api/* 会被浏览器拦截
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ========== Notification Config ==========
NOTIFY_EMAIL=admin@example.com
NOTIFY_DING_WEBHOOK=
NOTIFY_SLACK_WEBHOOK=

# ========== Multi-Tenant (SaaS) Config ==========
# 严格租户模式：开启后，执行租户级查询却没有租户上下文时直接抛错，
# 而不是"不过滤返回全量数据"。生产环境务必开启。
TENANT_STRICT_MODE=false
# 历史数据回填归属的默认租户（迁移 0006 使用）
DEFAULT_TENANT_SLUG=default
DEFAULT_TENANT_NAME=默认租户

# ========== Environment ==========
ENVIRONMENT=development  # development, staging, production
