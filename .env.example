# ========== Facebook API Config ==========
FB_APP_ID=your_app_id
FB_APP_SECRET=your_app_secret
FB_ACCESS_TOKEN=your_access_token
FB_ACCOUNT_ID=act_xxxxx

# ========== Database Config ==========
DB_TYPE=postgresql  # postgresql, mongodb
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fb_ads_db
DB_USER=postgres
DB_PASSWORD=your_password
MONGO_URI=mongodb://localhost:27017

# ========== Redis Config ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== Celery Config ==========
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ========== Risk Control Config ==========
RISK_ENABLE=true
RISK_DAILY_SPEND_LIMIT=10000  # 日花费上限
RISK_DAILY_CTR_THRESHOLD=0.02  # CTR下限
RISK_DAILY_CPC_THRESHOLD=5.0   # CPC上限
RISK_FRAUD_SCORE_THRESHOLD=0.7 # 欺诈评分阈值
RISK_ACCOUNT_FREEZE_DAYS=3     # 冻结账户天数

# ========== Logging Config ==========
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
SENTRY_DSN=

# ========== API Server Config ==========
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false
SECRET_KEY=your_secret_key_here

# ========== Notification Config ==========
NOTIFY_EMAIL=admin@example.com
NOTIFY_DING_WEBHOOK=
NOTIFY_SLACK_WEBHOOK=

# ========== Environment ==========
ENVIRONMENT=development  # development, staging, production