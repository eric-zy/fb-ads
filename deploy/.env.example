# ==================== 线上部署环境变量 ====================
# 复制为 .env 并按实际修改。生产务必改 SECRET_KEY / DB_PASSWORD / REDIS_PASSWORD

ENVIRONMENT=production
DEBUG=false
APP_ROLE=saas
FB_CONNECTOR_ENABLED=true
FB_ACCESS_MODE=connector

# JWT 密钥：生产必须改为随机 32+ 字节（可用 openssl rand -hex 32 生成）
SECRET_KEY=change-me-to-random-32-bytes

# ==================== 海外 FB Connector ====================
FB_CONNECTOR_BASE_URL=https://fb-api.example.com
FB_CONNECTOR_TIMEOUT=30
FB_CONNECTOR_SIGNING_KEY=change-me
CONNECTOR_SERVICE_TOKEN=change-me
SAAS_CALLBACK_BASE_URL=https://saas.example.com
SAAS_INTERNAL_SIGNING_KEY=change-me
FRONTEND_BASE_URL=https://saas.example.com

# ==================== PostgreSQL ====================
# compose 内服务名为 db；容器间通过 db 主机名互联
# 注意：密码不要包含 # @ : / 等特殊字符（连接 URL 是拼接出来的，特殊字符会导致解析失败）
DB_TYPE=postgresql
DB_HOST=db
DB_PORT=5432
DB_NAME=fb_ads_db
DB_USER=fbads
DB_PASSWORD=meta11116888

# ==================== Redis ====================
# 密码同样不要含 # @ : / 特殊字符
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=meta11116888
REDIS_DB=0

# ==================== Celery ====================
# 设了 REDIS_PASSWORD 后，下面两个 URL 必须带上密码，格式 redis://:密码@redis:6379/0
CELERY_BROKER_URL=redis://:meta11116888@redis:6379/0
CELERY_RESULT_BACKEND=redis://:meta11116888@redis:6379/1
CELERY_TIMEZONE=Asia/Singapore

# ==================== 阿里云 OSS 素材存储 ====================
MEDIA_STORAGE_PROVIDER=oss
ADS_OSS_ACCESS_KEY_ID=replace-with-ram-access-key-id
ADS_OSS_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret
ADS_OSS_BUCKET=q8picaaa
ADS_OSS_REGION=cn-beijing
# 可选；留空时根据 ADS_OSS_REGION 自动使用 https://oss-cn-beijing.aliyuncs.com
ADS_OSS_ENDPOINT=
OSS_BASE_PATH=ossuser/oversea
OSS_PLATFORM=meta
OSS_UPLOAD_EXPIRE_SECONDS=900
OSS_DOWNLOAD_EXPIRE_SECONDS=900

# ==================== Web ====================
# 本地 Vite 开发环境可直接允许 5173；生产改为实际前端域名。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 上传
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=209715200

# 日志
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log
