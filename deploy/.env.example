# ==================== 线上部署环境变量 ====================
# 复制为 .env 并按实际修改。生产务必改 SECRET_KEY / DB_PASSWORD / REDIS_PASSWORD

ENVIRONMENT=production
DEBUG=false
APP_ROLE=saas
FB_CONNECTOR_ENABLED=true
FB_ACCESS_MODE=connector
TENANT_STRICT_MODE=true

# JWT 密钥：生产必须改为随机 32+ 字节（可用 openssl rand -hex 32 生成）
SECRET_KEY=change-me-to-random-32-bytes

# ==================== 海外 FB Connector ====================
FB_CONNECTOR_BASE_URL=https://fb-api.example.com
FB_CONNECTOR_TIMEOUT=30
# Insights 可能因 Meta 限流及并发排队超过普通请求超时
FB_CONNECTOR_REPORT_TIMEOUT=300
FB_CONNECTOR_DELIVERY_POLL_MAX_RETRIES=140
FB_CONNECTOR_SIGNING_KEY=change-me
CONNECTOR_SERVICE_TOKEN=change-me
SAAS_CALLBACK_BASE_URL=https://saas.example.com
SAAS_INTERNAL_SIGNING_KEY=change-me
FRONTEND_BASE_URL=https://ads.example.com
# 临时 HTTP 部署必须显式改为 true；生产正式环境保持 false，并使用 HTTPS。
# 使用现有 HTTP 测试环境时，还需 NGINX_BIND_ADDRESS=0.0.0.0，
# 且 FRONTEND_BASE_URL / SAAS_CALLBACK_BASE_URL 均填写实际外部 HTTP 地址。
ALLOW_INSECURE_HTTP=false
NGINX_BIND_ADDRESS=127.0.0.1

# ==================== PostgreSQL ====================
# compose 内服务名为 db；容器间通过 db 主机名互联
# 注意：密码不要包含 # @ : / 等特殊字符（连接 URL 是拼接出来的，特殊字符会导致解析失败）
DB_TYPE=postgresql
DB_HOST=db
DB_PORT=5432
DB_NAME=fb_ads_db
DB_USER=fbads
DB_PASSWORD=meta11116888

# ==================== Redis ====================
# 密码同样不要含 # @ : / 特殊字符
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=meta11116888
REDIS_DB=0

# ==================== Celery ====================
# 设了 REDIS_PASSWORD 后，下面两个 URL 必须带上密码，格式 redis://:密码@redis:6379/0
CELERY_BROKER_URL=redis://:meta11116888@redis:6379/0
CELERY_RESULT_BACKEND=redis://:meta11116888@redis:6379/1
CELERY_TIMEZONE=Asia/Singapore
PUBLISH_DISPATCH_BATCH_SIZE=25
PUBLISH_DISPATCH_BATCH_DELAY_SECONDS=2

# ==================== 风控 ====================
# 由 Celery Beat 每小时触发账户风控检查；生产灰度期间建议先打开总开关。
SCHEDULE_RISK_CHECK_CRON=0 * * * *
RISK_ENABLE=true
RISK_DAILY_SPEND_LIMIT=10000
RISK_DAILY_CTR_THRESHOLD=0.02
RISK_DAILY_CPC_THRESHOLD=5.0
RISK_FRAUD_SCORE_THRESHOLD=0.7
RISK_ACCOUNT_FREEZE_DAYS=3
# true：只评估并记录 SKIPPED，不执行自动暂停/冻结；灰度验证完成后改为 false。
RISK_AUTOMATION_KILL_SWITCH=true

# ==================== 阿里云 OSS 素材存储 ====================
MEDIA_STORAGE_PROVIDER=oss
ADS_OSS_ACCESS_KEY_ID=replace-with-ram-access-key-id
ADS_OSS_ACCESS_KEY_SECRET=replace-with-ram-access-key-secret
ADS_OSS_BUCKET=q8picaaa
ADS_OSS_REGION=cn-beijing
# 可选；留空时根据 ADS_OSS_REGION 自动使用 https://oss-cn-beijing.aliyuncs.com
ADS_OSS_ENDPOINT=
OSS_BASE_PATH=ossuser/oversea
OSS_PLATFORM=meta
OSS_UPLOAD_EXPIRE_SECONDS=3600
# 大于该大小的文件使用 OSS Multipart 分片上传；16MiB 分片、浏览器 4 路并发。
OSS_MULTIPART_THRESHOLD_BYTES=16777216
OSS_MULTIPART_PART_SIZE_BYTES=16777216
OSS_DOWNLOAD_EXPIRE_SECONDS=900

# ==================== Web ====================
# 本地 Vite 开发环境可直接允许 5173；生产改为实际前端域名。
CORS_ORIGINS=https://ads.example.com

# 上传
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=1073741824

# 日志
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log

# SMTP: email reports success only after server acceptance.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT=10
# NOTIFY_EMAIL is the receiver; production credentials stay outside Git.

# Optional weekly historical Insights backfill (UTC cron; default disabled).
SCHEDULE_INSIGHTS_HISTORY_ENABLED=false
SCHEDULE_INSIGHTS_HISTORY_CRON=0 3 * * 0
SCHEDULE_INSIGHTS_HISTORY_DAYS=30
