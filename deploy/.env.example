# ==================== 线上部署环境变量 ====================
# 复制为 .env 并按实际修改。生产务必改 SECRET_KEY / DB_PASSWORD / REDIS_PASSWORD

ENVIRONMENT=production
DEBUG=false

# JWT 密钥：生产必须改为随机 32+ 字节（可用 openssl rand -hex 32 生成）
SECRET_KEY=change-me-to-random-32-bytes

# ==================== Facebook API ====================
FB_APP_ID=
FB_APP_SECRET=
FB_ACCESS_TOKEN=
FB_ACCOUNT_ID=

# ==================== PostgreSQL ====================
# compose 内服务名为 db；容器间通过 db 主机名互联
DB_TYPE=postgresql
DB_HOST=db
DB_PORT=5432
DB_NAME=fb_ads_db
DB_USER=fbads
DB_PASSWORD=change-me-strong-password

# ==================== Redis ====================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== Celery ====================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TIMEZONE=Asia/Singapore

# ==================== Web ====================
# CORS：先用 IP 直连，填服务器 IP（多个用逗号）
# 示例：http://192.168.1.217 或 http://203.0.113.10
CORS_ORIGINS=http://<服务器IP>

# 上传
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=209715200

# 日志
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log
