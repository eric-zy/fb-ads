# ==================== 线上部署环境变量 ====================
# 复制为 .env 并按实际修改。生产务必改 SECRET_KEY / DB_PASSWORD / REDIS_PASSWORD

ENVIRONMENT=production
DEBUG=false

# JWT 密钥：生产必须改为随机 32+ 字节（可用 openssl rand -hex 32 生成）
SECRET_KEY=change-me-to-random-32-bytes

# ==================== Facebook / Meta API ====================
# 必填：使用你自己的 Meta Developer App，不要填写其他平台/XMP 的 App ID。
FB_APP_ID=
FB_APP_SECRET=
FB_ACCESS_TOKEN=
FB_ACCOUNT_ID=
FB_API_VERSION=v18.0

# OAuth 回调必须与 Meta Developer App 后台配置完全一致。
# Docker 本地开发：API 暴露 8000 时使用下面地址。
FB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/meta-auth/callback
# OAuth 完成后跳回的前端地址；Vite 开发环境使用 5173，生产按实际域名修改。
FRONTEND_BASE_URL=http://localhost:5173
# V1 接入 BM + 广告账户所需的最小权限。
FB_OAUTH_SCOPES=ads_management,ads_read,business_management

# ==================== PostgreSQL ====================
# compose 内服务名为 db；容器间通过 db 主机名互联
# 注意：密码不要包含 # @ : / 等特殊字符（连接 URL 是拼接出来的，特殊字符会导致解析失败）
DB_TYPE=postgresql
DB_HOST=db
DB_PORT=5432
DB_NAME=fb_ads_db
DB_USER=fbads
DB_PASSWORD=meta11116888

# ==================== Redis ====================
# 密码同样不要含 # @ : / 特殊字符
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=meta11116888
REDIS_DB=0

# ==================== Celery ====================
# 设了 REDIS_PASSWORD 后，下面两个 URL 必须带上密码，格式 redis://:密码@redis:6379/0
CELERY_BROKER_URL=redis://:meta11116888@redis:6379/0
CELERY_RESULT_BACKEND=redis://:meta11116888@redis:6379/1
CELERY_TIMEZONE=Asia/Singapore

# ==================== Web ====================
# 本地 Vite 开发环境可直接允许 5173；生产改为实际前端域名。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 上传
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=209715200

# 日志
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log
