# 海外 FB Connector 专用配置；此文件不得部署到国内 SaaS 服务器
ENVIRONMENT=production
DEBUG=false
APP_ROLE=fb_connector
FB_ACCESS_MODE=direct
FB_CONNECTOR_ENABLED=true

SECRET_KEY=change-me-to-random-32-bytes

# Meta Developer App
FB_APP_ID=
FB_APP_SECRET=
FB_LOGIN_CONFIG_ID=
FB_API_VERSION=v25.0
FB_OAUTH_REDIRECT_URI=https://fb-api.example.com/internal/meta/oauth/callback
FB_OAUTH_SCOPES=business_management,ads_management,ads_read,pages_show_list,pages_read_engagement
FB_API_TIMEOUT=30
CONNECTOR_DELIVERY_LOCK_TTL=7200
FB_VIDEO_UPLOAD_TIMEOUT=900
# Meta resumable upload：单片读取上限；实际 offset 以 Meta 响应为准
FB_VIDEO_CHUNK_MAX_BYTES=10485760
FB_VIDEO_PROCESSING_TIMEOUT=900
FB_VIDEO_STATUS_POLL_INTERVAL=15
# 全部广告账户优先让 Meta 直接拉取 OSS 签名 URL；明确拒绝时自动回退本地分片上传
FB_VIDEO_FILE_URL_UPLOAD=true
# 保持为空，表示全部账户；不再按账户灰度
FB_VIDEO_FILE_URL_UPLOAD_ACCOUNTS=
# 无海外 OSS 时使用 Connector media worker 的本地临时目录
CONNECTOR_MEDIA_TEMP_DIR=/tmp/fb-connector-media
CONNECTOR_MEDIA_CACHE_TTL_SECONDS=86400
CONNECTOR_MEDIA_CACHE_MAX_BYTES=2147483648
CONNECTOR_MEDIA_CONTENT_LOCK_TTL=1800
CONNECTOR_MEDIA_CONTENT_LOCK_WAIT=900
CONNECTOR_MEDIA_MAX_DOWNLOAD_BYTES=1073741824
CONNECTOR_MEDIA_ACCOUNT_LOCK_TTL=3600
FB_API_RETRY_COUNT=3

# 与国内 SaaS 服务通信
SAAS_CALLBACK_BASE_URL=https://saas.example.com
SAAS_INTERNAL_SIGNING_KEY=change-me
CONNECTOR_SERVICE_TOKEN=change-me

# Connector 自己的数据库、Redis 和日志
DB_TYPE=postgresql
DB_HOST=db
DB_PORT=5432
DB_NAME=fb_ads_connector
DB_USER=fb_user
DB_PASSWORD=change-me
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me
CELERY_BROKER_URL=redis://:change-me@redis:6379/0
CELERY_RESULT_BACKEND=redis://:change-me@redis:6379/1
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log
