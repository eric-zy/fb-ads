# 前端镜像：多阶段构建（node build → nginx 托管）
# 说明：本地 Docker 拉取 node:20-alpine 在部分网络环境下容易反复 EOF，
# 改用非 alpine 变体提高拉取稳定性。
FROM node:20-bookworm-slim AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ .
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deploy/nginx/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
